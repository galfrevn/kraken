#!/bin/sh

# Get staged TS/JS files only (oxfmt crashes on JSON, YAML, MD)
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACMR -- '*.ts' '*.tsx' '*.js' '*.jsx')

if [ -z "$STAGED_FILES" ]; then
  exit 0
fi

echo "Running formatter on staged files..."

if ! bunx oxfmt --check $STAGED_FILES; then
  echo ""
  echo "Formatting issues found. Run 'bunx oxfmt .' to fix them."
  exit 1
fi
