{
  "devDependencies": {
    "@kraken/configuration": "workspace:*",
    "@types/bun": "^1.3.10",
    "oxfmt": "^0.26.0",
    "oxlint": "^1.41.0",
    "turbo": "^2.8.12",
    "typescript": "^5"
  },
  "name": "kraken",
  "packageManager": "bun@1.3.10",
  "private": true,
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "build": "turbo build",
    "dev": "bash scripts/dev/install.sh",
    "format": "turbo run format",
    "lint": "turbo run lint",
    "typecheck": "turbo typecheck"
  },
  "type": "module",
  "version": "0.2.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "dependencies": {
    "opentui-spinner": "^0.0.6"
  }
}
