{
  "extends": "../../packages/configuration/tsconfig.base.json",
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "baseUrl": ".",
    "types": ["bun"],
    "lib": ["ESNext"],
    "allowImportingTsExtensions": true
  },
  "include": ["src/**/*.ts"]
}
