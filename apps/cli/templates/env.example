# Kraken - Environment Variables
# These are optional overrides. The main config lives in ~/.kraken/kraken.yml

# API key (set during 'kraken init', override here if needed)
# OPENROUTER_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# Optional: Brave Search API key for web search tool
# BRAVE_SEARCH_API_KEY=
